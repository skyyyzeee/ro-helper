# RO Helper AI server settings. The real file is /opt/ro-helper/.env on the server; the key goes there only
# (bash /opt/ro-helper/set-key.sh asks for it). Change the rest with `nano /opt/ro-helper/.env`,
# then `systemctl restart ro-helper-ai`.

# The OpenAI-compatible AI API and its key (ProxyAPI by default).
AI_BASE_URL=https://api.proxyapi.ru/openai/v1
AI_API_KEY=
# Models, in turn: when one is busy at the provider (429), the next is asked.
AI_MODELS=gpt-5-nano,gpt-4.1-nano,gpt-4o-mini
AI_TRANSCRIBE_MODELS=whisper-1,gpt-4o-mini-transcribe

# Prices in rubles per 1M tokens (in / out) and per started minute of speech — for counting the budget.
PRICE_IN_RUB=13
PRICE_OUT_RUB=104
PRICE_MINUTE_RUB=1.6

# Budget for everyone together, rubles a day (~600 ₽ a month at 20).
BUDGET_RUB_PER_DAY=20

# Limits per computer and per internet address, a day.
QUESTIONS_PER_DEVICE=20
# Speech is recognised on the players' computers (Vosk): the paid recognition here is off.
VOICE_PER_DEVICE=0
REQUESTS_PER_IP=80
